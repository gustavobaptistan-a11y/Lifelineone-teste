# =============================================================
# LIFELINE ONE - VARIÁVEIS DE AMBIENTE (PRODUÇÃO)
# =============================================================

# Configurações do Projeto
PROJECT_NAME="Lifeline One - Plataforma e AI Orchestrator"
API_V1_STR="/api/v1"

# Banco de Dados PostgreSQL (Fonte da Verdade)
DATABASE_URL="postgresql+asyncpg://lifeline_user:lifeline_password@postgres:5432/lifeline_db"

# Redis (Filas e Eventos)
REDIS_URL="redis://redis:6379/0"

# Provedores de IA (Opcional - Ativa resposta generativa avançada Gemini / GPT-4o)
GEMINI_API_KEY="SUA_CHAVE_GEMINI_AQUI"
OPENAI_API_KEY="SUA_CHAVE_OPENAI_AQUI"

# Configurações de WhatsApp (Evolution API / Meta Cloud API)
WHATSAPP_PROVIDER="evolution" # "evolution" ou "meta_cloud"
EVOLUTION_API_URL="http://evolution_api:8080"
EVOLUTION_API_KEY="lifeline_secret_key"
EVOLUTION_INSTANCE="lifeline_instance"
